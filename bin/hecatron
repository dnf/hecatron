#!/usr/bin/env bash
# hecatron: toolchains, tests and CI for polyglot repositories (also `hct`).
# See docs/design.md for the commands and the project configuration.
set -euo pipefail

# The install directory: this script's real location, one level up from bin/.
# Homebrew links bin/hecatron (and bin/hct) into its prefix, so follow links.
_resolve_home() {
    local source="${BASH_SOURCE[0]}" dir
    while [ -L "${source}" ]; do
        dir="$(cd -P "$(dirname "${source}")" && pwd)"
        source="$(readlink "${source}")"
        [[ "${source}" != /* ]] && source="${dir}/${source}"
    done
    cd -P "$(dirname "${source}")/.." && pwd
}
HECATRON_HOME="${HECATRON_HOME:-$(_resolve_home)}"
export HECATRON_HOME

# The Go binary (docs/design.md §19), when install.sh downloaded one for the
# commit this install is at: it starts faster and has none of bash 3.2's
# limits, and runs the commands it hasn't ported through the scripts here.
# Anything else (a branch, a platform with no binary, a failed download)
# runs as before. HECATRON_NO_GO=1 keeps to the scripts.
_go="${HECATRON_HOME}/bin/.hecatron-go"
if [ -z "${HECATRON_NO_GO:-}" ] && [ -x "${_go}" ] && [ -f "${_go}.commit" ] && [ -f "${HECATRON_HOME}/.git/HEAD" ]; then
    read -r _head < "${HECATRON_HOME}/.git/HEAD" || true
    read -r _built < "${_go}.commit" || true
    if [ -n "${_built:-}" ] && [ "${_head:-}" = "${_built}" ]; then
        exec "${_go}" "$@"
    fi
fi

_version() { cat "${HECATRON_HOME}/VERSION"; }

_usage() {
    cat <<EOF
Usage: hecatron <command> [arguments]     (or: hct <command>)

Set up:
  status                     Languages, toolchain versions, last runs and changes at a glance
  init [dir]                 Set up a repository for hecatron
  doctor [--fix] [lang...]   Check toolchains; --fix runs installers to repair them
  install [lang...]          Install toolchains (all of the project's when none named)
  uninstall <lang...>        Uninstall toolchains
  get-started                Status table and install menu
  bootstrap                  Set up a fresh machine for the project (base packages + install)

Run (every component of each language; no languages means all, in parallel):
  test [lang...]             Tests
  lint [lang...|shell]       Linters (shell: shellcheck on every shell script)
  build [lang...]            Builds
  clean [lang...]            Remove build artifacts
  rebuild, retest [lang...]  Clean, then build or test
  audit [lang...]            Check dependencies for known vulnerabilities (--fail-on SEVERITY)
  outdated [lang...]         Report newer versions of dependencies (--json, --fail)
  deps [lang...]             Fetch dependencies, held to each component's lock file
  format [--check] [lang...] Format the code with each language's formatter (--check: change nothing)

Languages:
  list [languages] [--all]   Show the project's (or every known) language
  add <lang...>              Add languages to the project
  remove <lang...>           Remove languages from the project
  enable, disable <lang...>  Re-enable or skip languages in parallel runs, for you only

Generated files:
  dockerfile [--check]       Generate the Dockerfile from language snippets
  workflows [--check]        Generate each language's CI workflow
  check                      Verify every generated file is current
  banner --generator PATH    Print a DO NOT EDIT banner for a code generator

Project:
  parallel <name> "job"...   Run your own jobs (just recipes by default) with the live display
  env                        Print shell code for a project's own recipes: eval "\$(hecatron env)"
  env LANG [-c COMPONENT]    Print a language's environment (its version's PATH and variables)
                             gives HECATRON_* variables, the language lists and helpers
                             (_name, _check, _dep_available, _lang_grid, _ada_env, ...)
  version <version>          Bump versions through each language's version.sh
  metadata                   Update package metadata through metadata.sh hooks

Hecatron itself:
  self-test                  Check hecatron's own code: shellcheck and the unit tests
  skill install|path         Install hecatron's Agent Skill for AI coding agents

Run 'hecatron <command> help' for a command's options, and 'hecatron help agents'
for a compact reference for AI coding agents.
hecatron $(_version)
EOF
}

_command="${1:-help}"
[ "$#" -gt 0 ] && shift

case "${_command}" in
    help|-h|--help)
        if [ "${1:-}" = "agents" ]; then exec cat "${HECATRON_HOME}/docs/agents.md"; fi
        _usage; exit 0 ;;
    --version|-V|version-of-hecatron) _version; exit 0 ;;
esac

# What hecatron runs on: the bash and Python 3 that current macOS and Linux
# ship (bash 3.2 or later, Python 3.9 or later). Say how to get them rather
# than failing somewhere later.
if [ "${BASH_VERSINFO[0]}" -lt 3 ] || { [ "${BASH_VERSINFO[0]}" -eq 3 ] && [ "${BASH_VERSINFO[1]}" -lt 2 ]; }; then
    echo "hecatron: needs bash 3.2 or later (this is ${BASH_VERSION})" >&2
    exit 1
fi
if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
    if command -v python3 >/dev/null 2>&1; then
        echo "hecatron: needs Python 3.9 or later; python3 is $(python3 -V 2>&1 | sed 's/^Python //')." >&2
    else
        echo "hecatron: needs Python 3.9 or later, and there is no python3 on PATH." >&2
    fi
    echo "  macOS:          xcode-select --install   (or: brew install python)" >&2
    echo "  Debian, Ubuntu: sudo apt-get install python3" >&2
    echo "  Fedora:         sudo dnf install python3" >&2
    exit 1
fi

if [ "${_command}" = "self-test" ]; then
    exec bash "${HECATRON_HOME}/libexec/commands/self-test.sh" "$@"
fi

# Every command but init and banner runs inside a project; each finds it
# (like git) before running: the nearest .hecatron/config.json, else the git
# repository around it, read as hecatron init would set it up but without
# writing anything (project.py's detected_config). Unknown commands never
# get this far.
_project() {
    HECATRON_ROOT="$(python3 "${HECATRON_HOME}/libexec/lib/project.py" root)" || exit 1
    export HECATRON_ROOT
}

case "${_command}" in
    test|lint|build|clean|rebuild|retest|audit|format|deps|outdated)
        _project
        exec bash "${HECATRON_HOME}/libexec/commands/run.sh" "${_command}" "$@" ;;
    doctor)
        _project
        exec bash "${HECATRON_HOME}/libexec/commands/doctor.sh" "$@" ;;
    get-started)
        _project
        exec bash "${HECATRON_HOME}/libexec/onboarding/get-started.sh" "$@" ;;
    bootstrap)
        _project
        _env="$(python3 "${HECATRON_HOME}/libexec/lib/project.py" shell-env)"
        eval "${_env}"
        case "$(uname -s)" in
            Darwin) exec bash "${HECATRON_HOME}/libexec/bootstrap/macos.sh" ;;
            *) exec bash "${HECATRON_HOME}/libexec/bootstrap/linux.sh" ;;
        esac ;;
    metadata)
        _project
        exec bash "${HECATRON_HOME}/libexec/metadata/set.sh" "$@" ;;
    env)
        _project
        # With a language: that language's environment for one component
        # (docs/design.md §18), e.g. eval "$(hecatron env java -c age)".
        if [ "$#" -gt 0 ]; then
            _lang="$1"; shift
            _component=()
            if [ "${1:-}" = "-c" ] && [ -n "${2:-}" ]; then _component=("$2"); fi
            exec python3 "${HECATRON_HOME}/libexec/lib/project.py" env "${_lang}" ${_component[@]+"${_component[@]}"}
        fi
        printf 'export HECATRON_HOME=%q\n' "${HECATRON_HOME}"
        printf 'export HECATRON_ROOT=%q\n' "${HECATRON_ROOT}"
        printf 'source %q\n' "${HECATRON_HOME}/libexec/lib/helpers.sh"
        exit 0 ;;
    parallel)
        _project
        # A project's own job list through the runner, e.g. one job per CLI.
        # Jobs are just recipes unless HECATRON_JOB_COMMAND says otherwise.
        _env="$(python3 "${HECATRON_HOME}/libexec/lib/project.py" shell-env)"
        eval "${_env}"
        cd "${HECATRON_ROOT}"
        export HECATRON_JOB_COMMAND="${HECATRON_JOB_COMMAND:-just}"
        exec bash "${HECATRON_HOME}/libexec/runner/run-parallel.sh" "$@" ;;
    version)
        _project
        exec bash "${HECATRON_HOME}/libexec/commands/version.sh" "$@" ;;
    skill)
        # Native in the Go core only (docs/design.md §19).
        echo "hecatron: skill needs hecatron's binary, which install.sh downloads with a release; the skill itself is in ${HECATRON_HOME}/plugins/hecatron/skills/hecatron" >&2
        exit 1 ;;
    status)
        # Native in the Go core only (docs/design.md §19).
        echo "hecatron: status needs hecatron's binary, which install.sh downloads with a release; without it, hct list and hct doctor say most of it" >&2
        exit 1 ;;
    init|banner)
        exec python3 "${HECATRON_HOME}/libexec/commands/manage.py" "${_command}" "$@" ;;
    install|uninstall|list|add|remove|enable|disable|dockerfile|workflows|check)
        _project
        exec python3 "${HECATRON_HOME}/libexec/commands/manage.py" "${_command}" "$@" ;;
    *)
        echo "hecatron: unknown command '${_command}' (try 'hecatron help')" >&2
        exit 2 ;;
esac
