{
  "name": "Pharo",
  "homepage": "https://pharo.org",
  "summary": "Live, image-based Smalltalk environment.",
  "abbreviation": "ph",
  "dependency": "pharo",
  "lintDependency": null,
  "detect": [],
  "detectSources": [
    "*.st"
  ],
  "dirNames": [
    "pharo",
    "st",
    "smalltalk"
  ],
  "path": [
    "~/.local/bin"
  ],
  "buildSystems": [
    "Metacello (Tonel)"
  ],
  "testing": "SUnit",
  "linting": null,
  "cache": {
    "toolchain": [
      "~/.pharo"
    ],
    "dependencies": [
      "~/.cache/hecatron/pharo"
    ]
  },
  "installNeedsRoot": [
    "linux"
  ]
}
