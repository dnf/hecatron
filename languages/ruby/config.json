{
  "name": "Ruby",
  "homepage": "https://www.ruby-lang.org",
  "summary": "Expressive, object-oriented language behind Rails.",
  "abbreviation": "rb",
  "dependency": "ruby",
  "lintDependency": null,
  "detect": [
    "*.gemspec",
    "Gemfile"
  ],
  "dirNames": [
    "ruby",
    "rb"
  ],
  "path": [
    "{home}/bin"
  ],
  "version": "=4.0.9",
  "track": "stable",
  "pinFiles": [
    {
      "file": ".ruby-version",
      "format": "ruby-version"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "ruby"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "ruby"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "ruby"
    }
  ],
  "supportFiles": [
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "ruby-version"
    }
  ],
  "buildSystems": [
    "Bundler",
    "Rake",
    "RubyGems"
  ],
  "testing": "RSpec, Minitest",
  "linting": "RuboCop, Standard",
  "formatting": "RuboCop, Standard",
  "docs": "YARD, RDoc",
  "benchmarks": "Rake bench task",
  "errorPatterns": [
    {
      "tool": "rspec",
      "regex": "^\\s+\\d+\\) (?P<message>.+)$"
    },
    {
      "tool": "rspec",
      "regex": "^\\s+(?P<message>(?:Failure/Error|expected|got): .+)$"
    },
    {
      "tool": "rspec",
      "regex": "^\\s+# (?P<file>\\./\\S+\\.rb):(?P<line>\\d+):in"
    },
    {
      "tool": "rspec",
      "regex": "^rspec (?P<file>\\./\\S+\\.rb):(?P<line>\\d+) # (?P<message>.+)$"
    },
    {
      "tool": "minitest",
      "regex": "^(?P<message>\\S+#\\S+) \\[(?P<file>[^\\]:]+\\.rb):(?P<line>\\d+)\\]:$"
    },
    {
      "tool": "minitest",
      "regex": "^(?P<message>\\S+#\\S+):$"
    },
    {
      "tool": "minitest",
      "regex": "^\\s*(?P<message>(?:Expected|Actual): .+)$"
    },
    {
      "tool": "ruby",
      "regex": "^(?P<message>\\w+(?:Error|Exception): .+)$"
    }
  ],
  "notes": {
    "formatting": "Only when one is in the project's Gemfile."
  },
  "cache": {
    "dependencies": [
      "~/.local/share/gem"
    ],
    "lockFiles": [
      "Gemfile.lock"
    ]
  },
  "dependabot": "bundler",
  "renovate": [
    "bundler"
  ],
  "installNeedsRoot": [
    "linux"
  ]
}
