{
  "name": "Ruby",
  "homepage": "https://www.ruby-lang.org",
  "summary": "Expressive, object-oriented language behind Rails.",
  "abbreviation": "rb",
  "dependency": "ruby",
  "lintDependency": null,
  "detect": [
    "*.gemspec",
    "Gemfile"
  ],
  "dirNames": [
    "ruby",
    "rb"
  ],
  "path": [
    "{home}/bin"
  ],
  "version": "=4.0.9",
  "track": "stable",
  "pinFiles": [
    {
      "file": ".ruby-version",
      "format": "ruby-version"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "ruby"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "ruby"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "ruby"
    }
  ],
  "buildSystems": [
    "Bundler",
    "Rake",
    "RubyGems"
  ],
  "testing": "RSpec, Minitest",
  "linting": "RuboCop, Standard"
}
