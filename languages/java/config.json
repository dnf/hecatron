{
  "name": "Java",
  "homepage": "https://dev.java",
  "summary": "The JVM's flagship language.",
  "abbreviation": null,
  "dependency": "java",
  "lintDependency": null,
  "detect": [
    "pom.xml"
  ],
  "detectSources": [
    "*.java"
  ],
  "path": [
    "{home}/bin"
  ],
  "version": "=25.0.5",
  "track": "lts",
  "releaseLine": 1,
  "pinFiles": [
    {
      "file": ".java-version",
      "format": "java-version"
    },
    {
      "file": ".sdkmanrc",
      "format": "sdkmanrc",
      "key": "java"
    },
    {
      "file": "gradle/gradle-daemon-jvm.properties",
      "format": "gradle-daemon-jvm"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "java"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "java"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "java"
    }
  ],
  "supportFiles": [
    {
      "file": "pom.xml",
      "format": "maven-source-level"
    },
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "java-version"
    }
  ],
  "oldestInstallable": "11",
  "env": {
    "JAVA_HOME": "{home}"
  },
  "buildSystems": [
    "Maven",
    "Gradle"
  ],
  "testing": "JUnit",
  "linting": "Gradle check",
  "formatting": "Spotless, fmt-maven-plugin",
  "family": "jvm",
  "errorPatterns": [
    {
      "tool": "javac",
      "regex": "^\\s*(?P<file>\\S+\\.(?:java|kt|scala|groovy)):(?P<line>\\d+): error: (?P<message>.+)$"
    },
    {
      "tool": "maven",
      "regex": "^\\[ERROR\\] (?P<file>\\S+\\.(?:java|kt|scala|groovy)):\\[(?P<line>\\d+),(?P<col>\\d+)\\] (?P<message>.+)$"
    },
    {
      "tool": "maven",
      "regex": "^\\[ERROR\\]\\s+(?P<message>\\S+:\\d+ .+)$"
    },
    {
      "tool": "maven",
      "regex": "^\\[ERROR\\] (?P<message>\\S+ -- Time elapsed: .+<<< (?:FAILURE|ERROR)!)$"
    },
    {
      "tool": "junit",
      "regex": "^(?P<message>(?:org\\.opentest4j|org\\.junit|junit\\.framework|java\\.lang)\\.\\S+: .+)$"
    },
    {
      "tool": "gradle",
      "regex": "^(?P<message>\\S+ > .+ FAILED)$"
    },
    {
      "tool": "gradle",
      "regex": "^\\s+(?P<message>\\S+(?:Error|Exception|Failure)\\S* at (?P<file>\\S+\\.(?:java|kt|scala|groovy)):(?P<line>\\d+))$"
    },
    {
      "tool": "kotlin",
      "regex": "^e: (?:file://)?(?P<file>[^\\s:]+\\.kts?):(?P<line>\\d+):(?P<col>\\d+) (?P<message>.+)$"
    },
    {
      "tool": "kotlinc",
      "regex": "^(?P<file>\\S+\\.kts?):(?P<line>\\d+):(?P<col>\\d+): error: (?P<message>.+)$"
    },
    {
      "tool": "gradle",
      "regex": "^(?P<message>Execution failed for task .+)$"
    }
  ],
  "notes": {
    "formatting": "Only when the build applies one; hecatron runs it through the build."
  },
  "cache": {
    "dependencies": [
      "~/.m2/repository",
      "~/.gradle/caches",
      "~/.gradle/wrapper",
      "~/.cache/coursier",
      "~/.ivy2/cache",
      "~/.sbt"
    ],
    "lockFiles": [
      "pom.xml",
      "build.gradle",
      "build.gradle.kts",
      "settings.gradle",
      "settings.gradle.kts",
      "gradle.lockfile",
      "gradle/wrapper/gradle-wrapper.properties",
      "build.sbt"
    ]
  },
  "dependabot": [
    {
      "ecosystem": "maven",
      "files": [
        "pom.xml"
      ]
    },
    {
      "ecosystem": "gradle",
      "files": [
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts"
      ]
    },
    {
      "ecosystem": "sbt",
      "files": [
        "build.sbt"
      ]
    }
  ],
  "renovate": [
    "maven",
    "maven-wrapper",
    "gradle",
    "gradle-wrapper",
    "sbt"
  ]
}
