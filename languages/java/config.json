{
  "name": "Java",
  "homepage": "https://dev.java",
  "summary": "The JVM's flagship language.",
  "abbreviation": null,
  "dependency": "java",
  "lintDependency": null,
  "detect": [
    "pom.xml"
  ],
  "detectSources": [
    "*.java"
  ],
  "path": [
    "{home}/bin"
  ],
  "version": "=25.0.5",
  "track": "lts",
  "releaseLine": 1,
  "pinFiles": [
    {
      "file": ".java-version",
      "format": "java-version"
    },
    {
      "file": ".sdkmanrc",
      "format": "sdkmanrc",
      "key": "java"
    },
    {
      "file": "gradle/gradle-daemon-jvm.properties",
      "format": "gradle-daemon-jvm"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "java"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "java"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "java"
    }
  ],
  "supportFiles": [
    {
      "file": "pom.xml",
      "format": "maven-source-level"
    },
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "java-version"
    }
  ],
  "oldestInstallable": "11",
  "env": {
    "JAVA_HOME": "{home}"
  },
  "buildSystems": [
    "Maven",
    "Gradle"
  ],
  "testing": "JUnit",
  "linting": "Gradle check",
  "family": "jvm"
}
