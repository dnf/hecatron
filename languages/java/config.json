{
  "abbreviation": null,
  "dependency": "java",
  "lintDependency": null,
  "detect": [
    "pom.xml",
    "*.java"
  ],
  "path": [
    "{home}/bin"
  ],
  "version": "=25.0.5",
  "track": "lts",
  "pinFiles": [
    {
      "file": ".java-version",
      "format": "java-version"
    },
    {
      "file": ".sdkmanrc",
      "format": "sdkmanrc",
      "key": "java"
    },
    {
      "file": "gradle/gradle-daemon-jvm.properties",
      "format": "gradle-daemon-jvm"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "java"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "java"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "java"
    }
  ],
  "env": {
    "JAVA_HOME": "{home}"
  }
}
