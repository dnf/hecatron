{
  "schema": 1,
  "toolchain": {
    "versions": "managed",
    "archive": {
      "resolver": "adoptium",
      "strip": 1,
      "bin": {
        "macos": "Contents/Home/bin",
        "default": "bin"
      }
    },
    "platforms": {
      "windows-aarch64": {
        "archive": {
          "url": "https://aka.ms/download-jdk/microsoft-jdk-{version}-{os}-{arch}.{ext}",
          "checksum": "https://aka.ms/download-jdk/microsoft-jdk-{version}-{os}-{arch}.{ext}.sha256sum.txt",
          "os": {
            "windows": "windows"
          },
          "arch": {
            "aarch64": "aarch64"
          },
          "ext": {
            "default": "zip"
          },
          "strip": 1,
          "bin": {
            "default": "bin"
          }
        }
      }
    }
  }
}
