{
  "schema": 1,
  "toolchain": {
    "versions": "single",
    "archive": {
      "url": "https://github.com/gleam-lang/gleam/releases/download/v{version}/gleam-v{version}-{arch}-{os}.tar.gz",
      "os": {
        "linux": "unknown-linux-musl",
        "macos": "apple-darwin"
      },
      "arch": {
        "x86_64": "x86_64",
        "aarch64": "aarch64"
      },
      "checksum": "{url}.sha256",
      "check": {
        "run": [
          "{bin}/gleam",
          "--version"
        ]
      }
    }
  },
  "steps": [
    {
      "name": "Erlang/OTP",
      "run": [
        "bash",
        "-c",
        "exec bash \"${HECATRON_HOME}/languages/erlang/install.sh\""
      ],
      "check": {
        "run": [
          "erl",
          "-noshell",
          "-eval",
          "erlang:halt(case list_to_integer(erlang:system_info(otp_release)) >= 26 of true -> 0; false -> 1 end)."
        ]
      },
      "problem": "Erlang/OTP 26 or newer not installed (gleam build, run and test need erl)"
    }
  ],
  "links": [
    "gleam"
  ]
}
