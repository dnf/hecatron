{
  "name": "Gleam",
  "homepage": "https://gleam.run",
  "summary": "Friendly, type-safe language for the Erlang VM and JavaScript.",
  "abbreviation": "gm",
  "dependency": "gleam",
  "lintDependency": null,
  "detect": [
    "gleam.toml"
  ],
  "buildSystems": [
    "gleam"
  ],
  "testing": "gleeunit (gleam test)",
  "linting": "gleam format",
  "formatting": "gleam format",
  "docs": "gleam docs",
  "cache": {
    "dependencies": [
      "~/.cache/gleam"
    ],
    "lockFiles": [
      "manifest.toml"
    ]
  },
  "renovate": [
    "gleam"
  ],
  "version": "=1.14.0",
  "track": "stable",
  "path": [
    "{home}",
    "~/.local/share/hecatron/bin"
  ],
  "installNeedsRoot": [
    "linux"
  ]
}
