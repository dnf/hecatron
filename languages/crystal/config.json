{
  "name": "Crystal",
  "homepage": "https://crystal-lang.org",
  "summary": "Ruby-like syntax, statically typed and compiled to native code.",
  "abbreviation": "cr",
  "dependency": "crystal",
  "lintDependency": null,
  "detect": [
    "shard.yml"
  ],
  "dirNames": [
    "crystal",
    "cr"
  ],
  "buildSystems": [
    "Shards"
  ],
  "testing": "crystal spec",
  "linting": "crystal tool format",
  "formatting": "crystal tool format",
  "docs": "crystal docs",
  "cache": {
    "dependencies": [
      "~/.cache/shards",
      "lib"
    ],
    "lockFiles": [
      "shard.lock"
    ]
  },
  "installNeedsRoot": [
    "linux"
  ]
}
