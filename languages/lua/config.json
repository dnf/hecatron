{
  "name": "Lua",
  "homepage": "https://www.lua.org",
  "summary": "Lightweight embeddable scripting language.",
  "abbreviation": "lu",
  "dependency": "lua",
  "lintDependency": "luacheck",
  "detect": [
    "*.rockspec"
  ],
  "detectSources": [
    "*.lua"
  ],
  "detectUnless": [
    "premake*.lua"
  ],
  "path": [
    "~/.luarocks/bin"
  ],
  "buildSystems": [
    "LuaRocks"
  ],
  "testing": "busted",
  "linting": "luacheck",
  "formatting": "StyLua",
  "notes": {
    "formatting": "Only when the project has a `stylua.toml`."
  },
  "cache": {
    "toolchain": [
      "~/.luarocks"
    ]
  }
}
