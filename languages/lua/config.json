{
  "name": "Lua",
  "homepage": "https://www.lua.org",
  "summary": "Lightweight embeddable scripting language.",
  "abbreviation": "lu",
  "dependency": "lua",
  "lintDependency": "luacheck",
  "detect": [
    "*.rockspec"
  ],
  "detectSources": [
    "*.lua"
  ],
  "path": [
    "~/.luarocks/bin"
  ],
  "buildSystems": [
    "LuaRocks"
  ],
  "testing": "busted",
  "linting": "luacheck",
  "formatting": "StyLua (with a stylua.toml)"
}
