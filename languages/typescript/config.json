{
  "abbreviation": "ts",
  "dependency": "npm",
  "lintDependency": null,
  "detect": [
    "tsconfig.json"
  ],
  "path": [
    "{home}/bin"
  ],
  "version": "=24.22.1",
  "track": "lts",
  "releaseLine": 1,
  "pinFiles": [
    {
      "file": ".nvmrc",
      "format": "nvmrc"
    },
    {
      "file": ".node-version",
      "format": "node-version"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "nodejs"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "node"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "node"
    }
  ]
}
