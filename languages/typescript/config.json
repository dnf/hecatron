{
  "name": "TypeScript",
  "homepage": "https://www.typescriptlang.org",
  "summary": "JavaScript with static types.",
  "abbreviation": "ts",
  "dependency": "npm",
  "lintDependency": null,
  "detect": [
    "tsconfig.json"
  ],
  "detectYields": {
    "to": "javascript",
    "where": [
      "*.js",
      "*.jsx",
      "*.mjs",
      "*.cjs"
    ],
    "outnumber": [
      "*.ts",
      "*.tsx",
      "*.mts",
      "*.cts"
    ],
    "except": [
      "*.d.ts",
      "*.d.mts",
      "*.d.cts"
    ],
    "skipDirs": [
      "dist",
      "build",
      "out",
      "lib"
    ],
    "outputDir": [
      "compilerOptions",
      "outDir"
    ],
    "twins": true
  },
  "dirNames": [
    "typescript",
    "ts",
    "nodets",
    "javascript",
    "js",
    "nodejs"
  ],
  "path": [
    "{home}/bin",
    "~/.cache/hecatron/corepack-shims"
  ],
  "version": "=24.22.1",
  "track": "lts",
  "releaseLine": 1,
  "pinFiles": [
    {
      "file": ".nvmrc",
      "format": "nvmrc"
    },
    {
      "file": ".node-version",
      "format": "node-version"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "nodejs"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "node"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "node"
    }
  ],
  "supportFiles": [
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "node-version"
    }
  ],
  "buildSystems": [
    "npm, pnpm, Yarn or Bun (tsc)"
  ],
  "testing": "npm test",
  "linting": "npm run lint, tsc --noEmit",
  "formatting": "Prettier, Biome",
  "docs": "npm run docs, TypeDoc",
  "benchmarks": "npm run bench",
  "errorPatterns": [
    {
      "tool": "tsc",
      "regex": "^(?P<file>[^\\s(]+)\\((?P<line>\\d+),(?P<col>\\d+)\\): error (?P<message>TS\\d+: .+)$"
    },
    {
      "tool": "tsc",
      "regex": "^(?P<file>[^\\s:]+):(?P<line>\\d+):(?P<col>\\d+) - error (?P<message>TS\\d+: .+)$"
    },
    {
      "tool": "vitest",
      "regex": "^\\s*FAIL\\s+(?P<message>\\S+ > .+)$"
    },
    {
      "tool": "vitest",
      "regex": "^\\s*→ (?P<message>.+)$"
    },
    {
      "tool": "vitest",
      "regex": "^\\s*❯ (?P<file>[^\\s:]+):(?P<line>\\d+):(?P<col>\\d+)$"
    },
    {
      "tool": "jest",
      "regex": "^FAIL (?P<file>\\S+\\.[cm]?[jt]sx?)$"
    },
    {
      "tool": "jest",
      "regex": "^\\s*● (?P<message>.+)$"
    },
    {
      "tool": "jest",
      "regex": "^\\s*(?P<message>(?:Expected|Received): .+)$"
    },
    {
      "tool": "node-test",
      "regex": "^✖ (?P<message>.+)$"
    },
    {
      "tool": "node",
      "regex": "^\\s+at .*\\((?P<file>[^():\\s]+\\.[cm]?[jt]sx?):(?P<line>\\d+):(?P<col>\\d+)\\)$"
    },
    {
      "tool": "node",
      "regex": "^\\s*(?P<message>(?:AssertionError|TypeError|ReferenceError|SyntaxError|RangeError|Error)(?: \\[\\w+\\])?: .+)$"
    }
  ],
  "notes": {
    "formatting": "Only when the project depends on one, at the version it locks."
  },
  "cache": {
    "dependencies": [
      "~/.npm",
      "~/.cache/yarn",
      "~/.local/share/pnpm/store",
      "~/.bun/install/cache",
      "~/.cache/node/corepack"
    ],
    "lockFiles": [
      "package-lock.json",
      "npm-shrinkwrap.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "bun.lock",
      "bun.lockb"
    ]
  },
  "dependabot": [
    {
      "ecosystem": "bun",
      "files": [
        "bun.lock",
        "bun.lockb"
      ]
    },
    {
      "ecosystem": "npm",
      "unless": [
        "bun.lock",
        "bun.lockb"
      ]
    }
  ],
  "renovate": [
    "npm",
    "bun"
  ],
  "installNeedsRoot": [
    "linux"
  ]
}
