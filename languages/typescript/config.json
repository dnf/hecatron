{
  "name": "TypeScript",
  "homepage": "https://www.typescriptlang.org",
  "summary": "JavaScript with static types.",
  "abbreviation": "ts",
  "dependency": "npm",
  "lintDependency": null,
  "detect": [
    "tsconfig.json"
  ],
  "dirNames": [
    "typescript",
    "ts",
    "nodets",
    "javascript",
    "js",
    "nodejs"
  ],
  "path": [
    "{home}/bin"
  ],
  "version": "=24.22.1",
  "track": "lts",
  "releaseLine": 1,
  "pinFiles": [
    {
      "file": ".nvmrc",
      "format": "nvmrc"
    },
    {
      "file": ".node-version",
      "format": "node-version"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "nodejs"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "node"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "node"
    }
  ],
  "buildSystems": [
    "npm, pnpm, Yarn or Bun (tsc)"
  ],
  "testing": "npm test",
  "linting": "npm run lint, tsc --noEmit"
}
