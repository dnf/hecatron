{
  "name": "OCaml",
  "homepage": "https://ocaml.org",
  "summary": "Fast functional language with type inference and modules.",
  "abbreviation": "ml",
  "dependency": "opam",
  "lintDependency": null,
  "detect": [
    "dune-project"
  ],
  "dirNames": [
    "ocaml",
    "ml"
  ],
  "buildSystems": [
    "dune"
  ],
  "testing": "dune runtest",
  "linting": "ocamlformat, dune @check",
  "formatting": "ocamlformat",
  "docs": "odoc",
  "benchmarks": "dune build @bench",
  "notes": {
    "formatting": "Only when the project has a `.ocamlformat`."
  },
  "cache": {
    "dependencies": [
      "~/.opam"
    ],
    "lockFiles": [
      "*.opam",
      "*.opam.locked",
      "dune-project"
    ]
  },
  "installNeedsRoot": [
    "linux"
  ]
}
