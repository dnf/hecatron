{
  "name": "Elixir",
  "homepage": "https://elixir-lang.org",
  "summary": "Functional, concurrent language on the Erlang VM.",
  "abbreviation": "ex",
  "dependency": "mix",
  "lintDependency": null,
  "detect": [
    "mix.exs"
  ],
  "dirNames": [
    "elixir",
    "ex"
  ],
  "path": [
    "{home}/bin",
    "{home}/erlang/bin"
  ],
  "env": {
    "MIX_ARCHIVES": "{home}/archives"
  },
  "version": "=1.20.4",
  "track": "stable",
  "pinFiles": [
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "elixir",
      "strip": "-otp-[0-9]+$"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "elixir",
      "strip": "-otp-[0-9]+$"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "elixir",
      "strip": "-otp-[0-9]+$"
    }
  ],
  "supportFiles": [
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "elixir-version"
    }
  ],
  "buildSystems": [
    "Mix"
  ],
  "testing": "ExUnit",
  "linting": "mix format, Credo",
  "formatting": "mix format",
  "docs": "ExDoc",
  "benchmarks": "Benchee",
  "shared": {
    "deps": [
      {
        "run": [
          "mix",
          "deps.get"
        ],
        "if": {
          "all": [
            {
              "file": "mix.lock"
            },
            {
              "missing": "deps"
            }
          ]
        }
      }
    ]
  },
  "actions": {
    "test": {
      "files": [
        "mix.exs"
      ],
      "unknown": "no mix.exs",
      "steps": [
        {
          "use": "deps"
        },
        {
          "run": [
            "mix",
            "test"
          ]
        }
      ]
    },
    "lint": {
      "files": [
        "mix.exs"
      ],
      "unknown": "no mix.exs",
      "steps": [
        {
          "if": {
            "not": {
              "any": [
                {
                  "file": ".formatter.exs"
                },
                {
                  "contains": [
                    "mix.exs",
                    ":credo"
                  ]
                }
              ]
            }
          },
          "skip": "no .formatter.exs and no Credo dependency"
        },
        {
          "use": "deps"
        },
        {
          "run": [
            "mix",
            "format",
            "--check-formatted"
          ],
          "if": {
            "file": ".formatter.exs"
          }
        },
        {
          "run": [
            "mix",
            "credo",
            "--strict"
          ],
          "if": {
            "contains": [
              "mix.exs",
              ":credo"
            ]
          }
        }
      ]
    },
    "build": {
      "files": [
        "mix.exs"
      ],
      "unknown": "no mix.exs",
      "steps": [
        {
          "use": "deps"
        },
        {
          "run": [
            "mix",
            "compile"
          ]
        }
      ]
    },
    "clean": {
      "files": [
        "mix.exs"
      ],
      "unknown": "no mix.exs",
      "steps": [
        {
          "run": [
            "mix",
            "clean"
          ]
        },
        {
          "run": [
            "mix",
            "clean"
          ],
          "env": {
            "MIX_ENV": "test"
          }
        }
      ]
    }
  },
  "install": {
    "requires": [
      "erlang"
    ],
    "packages": {
      "apt": [
        "elixir"
      ],
      "brew": [
        "elixir"
      ],
      "scoop": [
        "elixir"
      ]
    }
  },
  "errorPatterns": [
    {
      "tool": "exunit",
      "regex": "^\\s+\\d+\\) (?P<message>test .+)$"
    },
    {
      "tool": "exunit",
      "regex": "^\\s+(?P<file>test/\\S+\\.exs):(?P<line>\\d+)$"
    },
    {
      "tool": "exunit",
      "regex": "^\\s+(?P<message>(?:Assertion with .+ failed|\\*\\* \\(\\w+(?:\\.\\w+)*\\) .+|left: .+|right: .+))$"
    },
    {
      "tool": "mix",
      "regex": "^\\*\\* \\((?:\\w+\\.)*\\w*Error\\) (?P<file>[^\\s:]+\\.exs?):(?P<line>\\d+)(?::(?P<col>\\d+))?: (?P<message>.+)$"
    },
    {
      "tool": "mix",
      "regex": "^\\s*error: (?P<message>.+)$",
      "next": "^\\s*(?:\u2514\u2500 )?(?P<file>[^\\s:]+\\.exs?):(?P<line>\\d+)(?::(?P<col>\\d+))?"
    }
  ],
  "cache": {
    "toolchain": [
      "~/.mix"
    ],
    "dependencies": [
      "~/.hex",
      "deps"
    ],
    "lockFiles": [
      "mix.lock"
    ]
  },
  "dependabot": "mix",
  "renovate": [
    "mix"
  ],
  "installNeedsRoot": [
    "linux"
  ]
}
