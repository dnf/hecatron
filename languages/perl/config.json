{
  "name": "Perl",
  "homepage": "https://www.perl.org",
  "summary": "Text-processing veteran with CPAN, the first great package archive.",
  "abbreviation": "pl",
  "dependency": "perl",
  "lintDependency": null,
  "detect": [
    "Makefile.PL",
    "Build.PL",
    "cpanfile"
  ],
  "detectSources": [
    "*.pm"
  ],
  "dirNames": [
    "perl",
    "perl5"
  ],
  "buildSystems": [
    "ExtUtils::MakeMaker",
    "Module::Build",
    "Carton"
  ],
  "testing": "prove (Test::More)",
  "linting": "Perl::Critic",
  "formatting": "perltidy (with a .perltidyrc)"
}
