{
  "name": "R",
  "homepage": "https://www.r-project.org",
  "summary": "The statistics and data analysis language.",
  "abbreviation": null,
  "dependency": "Rscript",
  "lintDependency": null,
  "detect": [
    "DESCRIPTION"
  ],
  "detectUnless": [
    "INDEX"
  ],
  "dirNames": [
    "r",
    "R"
  ],
  "buildSystems": [
    "R packages (DESCRIPTION)"
  ],
  "testing": "testthat",
  "linting": "lintr",
  "formatting": "Air",
  "notes": {
    "formatting": "Only when the project has an `air.toml`."
  },
  "cache": {
    "dependencies": [
      "~/.cache/R/renv"
    ],
    "lockFiles": [
      "renv.lock"
    ]
  },
  "installNeedsRoot": [
    "linux"
  ]
}
