{
  "name": "Objective-C",
  "homepage": "https://developer.apple.com/documentation/objectivec",
  "summary": "Smalltalk-style messaging on C; Apple's language before Swift.",
  "abbreviation": "objc",
  "dependency": "cc",
  "lintDependency": null,
  "detect": [
    "*.xcodeproj",
    "*.podspec"
  ],
  "detectSources": [
    "*.m",
    "*.mm"
  ],
  "dirNames": [
    "objectivec",
    "objective-c",
    "objc"
  ],
  "sharedBuildFiles": [
    "CMakeLists.txt",
    "meson.build",
    "configure.ac",
    "Makefile"
  ],
  "buildSystems": [
    "Xcode",
    "GNUstep make",
    "CMake",
    "make"
  ],
  "testing": "XCTest, test programs",
  "linting": null,
  "formatting": "clang-format",
  "notes": {
    "formatting": "Only when the project has a `.clang-format` file: C-family code has no single standard style."
  }
}
