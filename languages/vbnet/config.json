{
  "name": "VB.NET",
  "homepage": "https://learn.microsoft.com/dotnet/visual-basic/",
  "summary": "Visual Basic for .NET.",
  "abbreviation": "vb",
  "dependency": "dotnet",
  "lintDependency": null,
  "detect": [
    "*.vbproj"
  ],
  "dirNames": [
    "vbnet",
    "vb"
  ],
  "path": [
    "{home}"
  ],
  "version": "=10.0.403",
  "track": "lts",
  "releaseLine": 3,
  "pinFiles": [
    {
      "file": "global.json",
      "format": "global-json"
    }
  ],
  "supportFiles": [
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "dotnet-version"
    }
  ],
  "oldestInstallable": "6.0",
  "releasesOf": "csharp",
  "env": {
    "DOTNET_ROOT": "{home}"
  },
  "buildSystems": [
    ".NET SDK (dotnet)"
  ],
  "testing": "dotnet test",
  "linting": "dotnet format"
}
