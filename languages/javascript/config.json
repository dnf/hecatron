{
  "name": "JavaScript",
  "homepage": "https://developer.mozilla.org/docs/Web/JavaScript",
  "summary": "The web's language, on Node.js.",
  "abbreviation": "js",
  "dependency": "npm",
  "lintDependency": null,
  "detect": [
    "package.json"
  ],
  "detectUnless": [
    "tsconfig.json"
  ],
  "detectScript": "test",
  "dirNames": [
    "javascript",
    "js",
    "nodejs"
  ],
  "path": [
    "{home}/bin"
  ],
  "version": "=24.22.1",
  "track": "lts",
  "releaseLine": 1,
  "pinFiles": [
    {
      "file": ".nvmrc",
      "format": "nvmrc"
    },
    {
      "file": ".node-version",
      "format": "node-version"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "nodejs"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "node"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "node"
    }
  ],
  "supportFiles": [
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "node-version"
    }
  ],
  "releasesOf": "typescript",
  "buildSystems": [
    "npm, pnpm, Yarn or Bun"
  ],
  "testing": "npm test (node:test, Jest...)",
  "linting": "npm run lint (ESLint...)",
  "formatting": "Prettier, Biome",
  "errorPatterns": [
    {
      "tool": "tsc",
      "regex": "^(?P<file>[^\\s(]+)\\((?P<line>\\d+),(?P<col>\\d+)\\): error (?P<message>TS\\d+: .+)$"
    },
    {
      "tool": "tsc",
      "regex": "^(?P<file>[^\\s:]+):(?P<line>\\d+):(?P<col>\\d+) - error (?P<message>TS\\d+: .+)$"
    },
    {
      "tool": "vitest",
      "regex": "^\\s*FAIL\\s+(?P<message>\\S+ > .+)$"
    },
    {
      "tool": "vitest",
      "regex": "^\\s*→ (?P<message>.+)$"
    },
    {
      "tool": "vitest",
      "regex": "^\\s*❯ (?P<file>[^\\s:]+):(?P<line>\\d+):(?P<col>\\d+)$"
    },
    {
      "tool": "jest",
      "regex": "^FAIL (?P<file>\\S+\\.[cm]?[jt]sx?)$"
    },
    {
      "tool": "jest",
      "regex": "^\\s*● (?P<message>.+)$"
    },
    {
      "tool": "jest",
      "regex": "^\\s*(?P<message>(?:Expected|Received): .+)$"
    },
    {
      "tool": "node-test",
      "regex": "^✖ (?P<message>.+)$"
    },
    {
      "tool": "node",
      "regex": "^\\s+at .*\\((?P<file>[^():\\s]+\\.[cm]?[jt]sx?):(?P<line>\\d+):(?P<col>\\d+)\\)$"
    },
    {
      "tool": "node",
      "regex": "^\\s*(?P<message>(?:AssertionError|TypeError|ReferenceError|SyntaxError|RangeError|Error)(?: \\[\\w+\\])?: .+)$"
    }
  ],
  "notes": {
    "formatting": "Only when the project depends on one, at the version it locks."
  },
  "cache": {
    "dependencies": [
      "~/.npm",
      "~/.cache/yarn",
      "~/.local/share/pnpm/store",
      "~/.bun/install/cache",
      "~/.cache/node/corepack"
    ],
    "lockFiles": [
      "package-lock.json",
      "npm-shrinkwrap.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "bun.lock",
      "bun.lockb"
    ]
  },
  "dependabot": [
    {
      "ecosystem": "bun",
      "files": [
        "bun.lock",
        "bun.lockb"
      ]
    },
    {
      "ecosystem": "npm",
      "unless": [
        "bun.lock",
        "bun.lockb"
      ]
    }
  ],
  "renovate": [
    "npm",
    "bun"
  ]
}
