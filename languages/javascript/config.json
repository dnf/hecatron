{
  "name": "JavaScript",
  "homepage": "https://developer.mozilla.org/docs/Web/JavaScript",
  "summary": "The web's language, on Node.js.",
  "abbreviation": "js",
  "dependency": "npm",
  "lintDependency": null,
  "detect": [
    "package.json"
  ],
  "detectUnless": [
    "tsconfig.json"
  ],
  "dirNames": [
    "javascript",
    "js",
    "nodejs"
  ],
  "path": [
    "{home}/bin"
  ],
  "version": "=24.22.1",
  "track": "lts",
  "releaseLine": 1,
  "pinFiles": [
    {
      "file": ".nvmrc",
      "format": "nvmrc"
    },
    {
      "file": ".node-version",
      "format": "node-version"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "nodejs"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "node"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "node"
    }
  ],
  "supportFiles": [
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "node-version"
    }
  ],
  "releasesOf": "typescript",
  "buildSystems": [
    "npm, pnpm, Yarn or Bun"
  ],
  "testing": "npm test (node:test, Jest...)",
  "linting": "npm run lint (ESLint...)",
  "formatting": "Prettier, Biome (when a dependency)"
}
