# after: typescript

# Node.js 22 via NodeSource, as TypeScript's snippet installs it (skipped
# when TypeScript's snippet already has)
RUN command -v node >/dev/null || { curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*; }
