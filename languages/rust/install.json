{
  "schema": 1,
  "toolchain": {
    "versions": "managed",
    "vendor": {
      "url": {
        "unix": "https://sh.rustup.rs",
        "windows": "https://static.rust-lang.org/rustup/dist/{arch}-pc-windows-msvc/rustup-init.exe"
      },
      "run": {
        "unix": [
          "sh",
          "{file}",
          "-y",
          "--no-modify-path",
          "--profile",
          "minimal",
          "--component",
          "clippy,rustfmt",
          "--default-toolchain",
          "{version}"
        ],
        "windows": [
          "{file}",
          "-y",
          "--no-modify-path",
          "--profile",
          "minimal",
          "--component",
          "clippy,rustfmt",
          "--default-toolchain",
          "{version}"
        ]
      },
      "arch": {
        "x86_64": "x86_64",
        "aarch64": "aarch64"
      },
      "env": {
        "RUSTUP_HOME": "{toolchains}/rustup",
        "CARGO_HOME": "{toolchains}/cargo"
      },
      "bin": "{toolchains}/cargo/bin"
    }
  }
}
