{
  "name": "Rust",
  "homepage": "https://www.rust-lang.org",
  "summary": "Memory safety without garbage collection, and fearless concurrency.",
  "abbreviation": "rs",
  "dependency": "cargo",
  "lintDependency": null,
  "detect": [
    "Cargo.toml"
  ],
  "dirNames": [
    "rust",
    "rs"
  ],
  "path": [
    "{home}/bin",
    "~/.cargo/bin"
  ],
  "version": "=1.99.1",
  "track": "stable",
  "pinFiles": [
    {
      "file": "rust-toolchain.toml",
      "format": "rust-toolchain-toml"
    },
    {
      "file": "rust-toolchain",
      "format": "rust-toolchain"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "rust"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "rust"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "rust"
    }
  ],
  "buildSystems": [
    "Cargo"
  ],
  "testing": "cargo test",
  "linting": "Clippy, rustfmt",
  "formatting": "rustfmt",
  "actions": {
    "test": {
      "find": "above-first",
      "files": [
        "Cargo.toml"
      ],
      "steps": [
        {
          "run": [
            "cargo",
            "test",
            "--all-targets"
          ]
        }
      ]
    },
    "lint": {
      "find": "above-first",
      "files": [
        "Cargo.toml"
      ],
      "steps": [
        {
          "run": [
            "cargo",
            "clippy",
            "--all-targets",
            "--",
            "-D",
            "warnings"
          ]
        },
        {
          "run": [
            "cargo",
            "fmt",
            "--all",
            "--",
            "--check"
          ]
        }
      ]
    },
    "build": {
      "find": "above-first",
      "files": [
        "Cargo.toml"
      ],
      "steps": [
        {
          "run": [
            "cargo",
            "build",
            "--all-targets"
          ]
        }
      ]
    },
    "clean": {
      "find": "above-first",
      "files": [
        "Cargo.toml"
      ],
      "steps": [
        {
          "run": [
            "cargo",
            "clean"
          ]
        }
      ]
    }
  },
  "install": {
    "vendor": {
      "url": {
        "unix": "https://sh.rustup.rs",
        "windows": "https://static.rust-lang.org/rustup/dist/{arch}-pc-windows-msvc/rustup-init.exe"
      },
      "run": {
        "unix": [
          "sh",
          "{file}",
          "-y",
          "--no-modify-path",
          "--profile",
          "minimal",
          "--component",
          "clippy,rustfmt",
          "--default-toolchain",
          "{version}"
        ],
        "windows": [
          "{file}",
          "-y",
          "--no-modify-path",
          "--profile",
          "minimal",
          "--component",
          "clippy,rustfmt",
          "--default-toolchain",
          "{version}"
        ]
      },
      "arch": {
        "x86_64": "x86_64",
        "aarch64": "aarch64"
      },
      "env": {
        "RUSTUP_HOME": "{toolchains}/rustup",
        "CARGO_HOME": "{toolchains}/cargo"
      },
      "bin": "{toolchains}/cargo/bin"
    }
  }
}
