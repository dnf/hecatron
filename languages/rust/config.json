{
  "name": "Rust",
  "homepage": "https://www.rust-lang.org",
  "summary": "Memory safety without garbage collection, and fearless concurrency.",
  "abbreviation": "rs",
  "dependency": "cargo",
  "lintDependency": null,
  "detect": [
    "Cargo.toml"
  ],
  "dirNames": [
    "rust",
    "rs"
  ],
  "path": [
    "{home}/bin",
    "~/.cargo/bin"
  ],
  "version": "=1.99.1",
  "track": "stable",
  "pinFiles": [
    {
      "file": "rust-toolchain.toml",
      "format": "rust-toolchain-toml"
    },
    {
      "file": "rust-toolchain",
      "format": "rust-toolchain"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "rust"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "rust"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "rust"
    }
  ],
  "buildSystems": [
    "Cargo"
  ],
  "testing": "cargo test",
  "linting": "Clippy, rustfmt",
  "formatting": "rustfmt"
}
