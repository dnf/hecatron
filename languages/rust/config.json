{
  "name": "Rust",
  "homepage": "https://www.rust-lang.org",
  "summary": "Memory safety without garbage collection, and fearless concurrency.",
  "abbreviation": "rs",
  "dependency": "cargo",
  "lintDependency": null,
  "detect": [
    "Cargo.toml"
  ],
  "dirNames": [
    "rust",
    "rs"
  ],
  "path": [
    "{home}/bin",
    "~/.cargo/bin"
  ],
  "version": "=1.99.1",
  "track": "stable",
  "pinFiles": [
    {
      "file": "rust-toolchain.toml",
      "format": "rust-toolchain-toml"
    },
    {
      "file": "rust-toolchain",
      "format": "rust-toolchain"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "rust"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "rust"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "rust"
    }
  ],
  "buildSystems": [
    "Cargo"
  ],
  "testing": "cargo test",
  "linting": "Clippy, rustfmt",
  "formatting": "rustfmt",
  "actions": {
    "test": {
      "find": "above-first",
      "files": [
        "Cargo.toml"
      ],
      "steps": [
        {
          "run": [
            "cargo",
            "test"
          ]
        }
      ]
    },
    "lint": {
      "find": "above-first",
      "files": [
        "Cargo.toml"
      ],
      "steps": [
        {
          "run": [
            "cargo",
            "clippy",
            "--all-targets",
            "--",
            "-D",
            "warnings"
          ]
        },
        {
          "run": [
            "cargo",
            "fmt",
            "--all",
            "--",
            "--check"
          ]
        }
      ]
    },
    "build": {
      "find": "above-first",
      "files": [
        "Cargo.toml"
      ],
      "steps": [
        {
          "run": [
            "cargo",
            "build",
            "--all-targets"
          ]
        }
      ]
    },
    "clean": {
      "find": "above-first",
      "files": [
        "Cargo.toml"
      ],
      "steps": [
        {
          "run": [
            "cargo",
            "clean"
          ]
        }
      ]
    }
  },
  "errorPatterns": [
    {
      "tool": "cargo",
      "regex": "^(?P<message>error(?:\\[E\\d+\\])?: .+)$",
      "next": "^\\s*--> (?P<file>[^\\s:]+):(?P<line>\\d+):(?P<col>\\d+)$"
    },
    {
      "tool": "cargo",
      "regex": "^thread '.+' (?:\\(\\d+\\) )?panicked at (?P<file>[^\\s:]+):(?P<line>\\d+):(?P<col>\\d+):$"
    },
    {
      "tool": "cargo",
      "regex": "^(?P<message>assertion .+ failed.*)$"
    },
    {
      "tool": "cargo",
      "regex": "^\\s+(?P<message>(?:left|right): .+)$"
    },
    {
      "tool": "cargo",
      "regex": "^test (?P<message>\\S+ \\.\\.\\. FAILED)$"
    }
  ],
  "cache": {
    "toolchain": [
      "~/.rustup",
      "~/.cargo/bin"
    ],
    "dependencies": [
      "~/.cargo/registry",
      "~/.cargo/git"
    ],
    "lockFiles": [
      "Cargo.lock"
    ]
  },
  "dependabot": "cargo",
  "renovate": [
    "cargo"
  ],
  "installNeedsRoot": [
    "linux"
  ]
}
