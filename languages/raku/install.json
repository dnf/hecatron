{
  "schema": 1,
  "toolchain": {
    "versions": "system",
    "packages": {
      "apt": [
        "rakudo"
      ],
      "brew": [
        "rakudo"
      ]
    }
  },
  "tools": [
    {
      "name": "zef",
      "when": {
        "glob": "META6.json",
        "because": "a component has a META6.json"
      },
      "packages": {
        "apt": [
          "raku-zef"
        ],
        "brew": [
          "zef"
        ]
      },
      "check": {
        "command": "zef"
      }
    }
  ]
}
