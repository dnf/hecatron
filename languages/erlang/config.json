{
  "name": "Erlang",
  "homepage": "https://www.erlang.org",
  "summary": "Fault-tolerant concurrency on the BEAM, born at Ericsson.",
  "abbreviation": "erl",
  "dependency": "rebar3",
  "lintDependency": null,
  "detect": [
    "rebar.config"
  ],
  "dirNames": [
    "erlang",
    "erl"
  ],
  "buildSystems": [
    "rebar3"
  ],
  "testing": "EUnit, Common Test",
  "linting": "Dialyzer",
  "formatting": "erlfmt",
  "notes": {
    "formatting": "As a rebar3 plugin, when the project's rebar.config has it."
  },
  "cache": {
    "dependencies": [
      "~/.cache/rebar3"
    ],
    "lockFiles": [
      "rebar.lock"
    ]
  },
  "path": [
    "~/.local/share/hecatron/bin"
  ],
  "version": "=29.1.2",
  "track": "stable",
  "releaseLine": 1,
  "installNeedsRoot": [
    "linux"
  ]
}
