{
  "name": "Swift",
  "homepage": "https://www.swift.org",
  "summary": "Apple's safe, fast language, also on Linux.",
  "abbreviation": "sw",
  "dependency": "swift",
  "lintDependency": null,
  "detect": [
    "Package.swift"
  ],
  "detectWithSources": {
    "dirs": [
      "*.xcodeproj",
      "*.xcworkspace"
    ],
    "sources": [
      "*.swift"
    ]
  },
  "buildSystems": [
    "Swift Package Manager",
    "Xcode (xcodebuild build and clean)"
  ],
  "testing": "XCTest, Swift Testing",
  "linting": null,
  "formatting": "swift-format",
  "docs": "DocC",
  "benchmarks": "package-benchmark",
  "cache": {
    "dependencies": [
      "~/.cache/org.swift.swiftpm"
    ],
    "lockFiles": [
      "Package.resolved"
    ]
  },
  "dependabot": "swift",
  "renovate": [
    "swift"
  ],
  "installNeedsRoot": [
    "linux"
  ]
}
