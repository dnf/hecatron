{
  "name": "Ada",
  "homepage": "https://ada-lang.io",
  "summary": "Safety-critical systems language with strong typing and contracts (SPARK).",
  "abbreviation": "ad",
  "dependency": "gnat",
  "lintDependency": null,
  "detect": [
    "alire.toml",
    "*.gpr"
  ],
  "path": [
    "~/.local/bin",
    "~/.local/share/alire/toolchains/*/bin"
  ],
  "sdkrootFromXcrun": true,
  "buildSystems": [
    "Alire",
    "GPRbuild"
  ],
  "testing": "Alire, GPRbuild test projects",
  "linting": null
}
