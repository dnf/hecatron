{
  "name": "Dart",
  "homepage": "https://dart.dev",
  "summary": "Client-optimized language behind Flutter.",
  "abbreviation": "dt",
  "dependency": "dart",
  "lintDependency": null,
  "detect": [
    "pubspec.yaml"
  ],
  "buildSystems": [
    "pub (dart, flutter)"
  ],
  "testing": "package:test",
  "linting": "dart analyze",
  "formatting": "dart format",
  "docs": "dart doc",
  "cache": {
    "dependencies": [
      "~/.pub-cache"
    ],
    "lockFiles": [
      "pubspec.lock"
    ]
  },
  "dependabot": "pub",
  "renovate": [
    "pub"
  ],
  "installNeedsRoot": [
    "linux",
    "macos"
  ]
}
