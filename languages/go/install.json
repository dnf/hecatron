{
  "schema": 1,
  "toolchain": {
    "versions": "managed",
    "archive": {
      "url": "https://dl.google.com/go/go{version}.{os}-{arch}.{ext}",
      "checksum": "https://dl.google.com/go/go{version}.{os}-{arch}.{ext}.sha256",
      "os": {
        "linux": "linux",
        "macos": "darwin",
        "windows": "windows"
      },
      "arch": {
        "x86_64": "amd64",
        "aarch64": "arm64"
      },
      "ext": {
        "windows": "zip",
        "default": "tar.gz"
      },
      "strip": 1,
      "bin": {
        "default": "bin"
      }
    }
  }
}
