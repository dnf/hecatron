{
  "name": "Go",
  "homepage": "https://go.dev",
  "summary": "Simple, fast-compiling language with built-in concurrency.",
  "abbreviation": null,
  "dependency": "go",
  "lintDependency": "golangci-lint",
  "detect": [
    "go.mod"
  ],
  "dirNames": [
    "go",
    "golang"
  ],
  "path": [
    "{home}/bin",
    "~/.local/bin",
    "~/go/bin"
  ],
  "version": "=1.27.3",
  "track": "stable",
  "pinFiles": [
    {
      "file": "go.mod",
      "format": "go-mod-toolchain"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "golang"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "go"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "go"
    }
  ],
  "supportFiles": [
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "go-version"
    }
  ],
  "buildSystems": [
    "go modules"
  ],
  "testing": "go test",
  "linting": "golangci-lint",
  "formatting": "gofmt",
  "actions": {
    "test": {
      "find": "above-first",
      "files": [
        "go.mod"
      ],
      "steps": [
        {
          "run": [
            "go",
            "test",
            "./..."
          ]
        }
      ]
    },
    "lint": {
      "find": "above-first",
      "files": [
        "go.mod"
      ],
      "steps": [
        {
          "run": [
            "golangci-lint",
            "run",
            "./..."
          ]
        }
      ]
    },
    "build": {
      "find": "above-first",
      "files": [
        "go.mod"
      ],
      "steps": [
        {
          "run": [
            "go",
            "build",
            "./..."
          ]
        }
      ]
    },
    "clean": {
      "find": "above-first",
      "files": [
        "go.mod"
      ],
      "steps": [
        {
          "run": [
            "go",
            "clean",
            "./..."
          ]
        }
      ]
    }
  },
  "install": {
    "archive": {
      "url": "https://dl.google.com/go/go{version}.{os}-{arch}.{ext}",
      "checksum": "https://dl.google.com/go/go{version}.{os}-{arch}.{ext}.sha256",
      "os": {
        "linux": "linux",
        "macos": "darwin",
        "windows": "windows"
      },
      "arch": {
        "x86_64": "amd64",
        "aarch64": "arm64"
      },
      "ext": {
        "windows": "zip",
        "default": "tar.gz"
      },
      "strip": 1,
      "bin": {
        "default": "bin"
      }
    }
  },
  "errorPatterns": [
    {
      "tool": "go",
      "regex": "^\\s*(?P<file>[^\\s:]+\\.go):(?P<line>\\d+)(?::(?P<col>\\d+))?: (?P<message>.+)$"
    },
    {
      "tool": "go",
      "regex": "^--- FAIL: (?P<message>.+)$"
    },
    {
      "tool": "go",
      "regex": "^panic: (?P<message>.+)$"
    },
    {
      "tool": "go",
      "regex": "^FAIL\\s+(?P<message>\\S+\\s+\\[(?:build|setup) failed\\])$"
    }
  ],
  "cache": {
    "dependencies": [
      "~/go/pkg/mod",
      "~/.cache/go-build"
    ],
    "lockFiles": [
      "go.sum"
    ]
  }
}
