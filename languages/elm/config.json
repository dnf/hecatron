{
  "name": "Elm",
  "homepage": "https://elm-lang.org",
  "summary": "Pure functional language for web front ends, with no runtime exceptions.",
  "abbreviation": "el",
  "dependency": "elm",
  "lintDependency": null,
  "detect": [
    "elm.json"
  ],
  "unsupported": [
    "linux-aarch64"
  ],
  "buildSystems": [
    "elm"
  ],
  "testing": "elm-test",
  "linting": "elm-review",
  "formatting": "elm-format",
  "cache": {
    "dependencies": [
      "~/.elm"
    ],
    "lockFiles": [
      "elm.json"
    ]
  }
}
