{
  "name": "Haskell",
  "homepage": "https://www.haskell.org",
  "summary": "Lazy, purely functional language with a powerful type system.",
  "abbreviation": "hs",
  "dependency": "cabal",
  "lintDependency": null,
  "detect": [
    "*.cabal",
    "stack.yaml"
  ],
  "dirNames": [
    "haskell",
    "hs"
  ],
  "path": [
    "~/.ghcup/bin"
  ],
  "buildSystems": [
    "Stack",
    "cabal"
  ],
  "testing": "test suites",
  "linting": "HLint, cabal check",
  "formatting": "Fourmolu, Ormolu",
  "notes": {
    "formatting": "Only when the project configures one."
  },
  "cache": {
    "toolchain": [
      "~/.ghcup"
    ],
    "dependencies": [
      "~/.cabal/packages",
      "~/.cabal/store",
      "~/.cache/cabal",
      "~/.local/state/cabal",
      "~/.stack"
    ],
    "lockFiles": [
      "cabal.project.freeze",
      "*.cabal",
      "stack.yaml",
      "stack.yaml.lock"
    ]
  },
  "renovate": [
    "haskell-cabal"
  ]
}
