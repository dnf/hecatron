{
  "name": "C++",
  "homepage": "https://isocpp.org",
  "summary": "Zero-overhead systems language with templates and RAII.",
  "abbreviation": "c++",
  "dependency": "cmake",
  "lintDependency": null,
  "detect": [],
  "detectSources": [
    "*.cpp",
    "*.cc",
    "*.cxx",
    "*.hpp"
  ],
  "sharedBuildFiles": [
    "CMakeLists.txt",
    "meson.build",
    "configure.ac",
    "Makefile"
  ],
  "dirNames": [
    "cpp",
    "c++",
    "cxx",
    "cc"
  ],
  "buildSystems": [
    "CMake",
    "Meson",
    "Autotools",
    "make"
  ],
  "testing": "CTest, Meson test, make check",
  "linting": null,
  "formatting": "clang-format",
  "errorPatterns": [
    {
      "tool": "gcc",
      "regex": "^(?P<file>[^\\s:]+):(?P<line>\\d+):(?P<col>\\d+): (?:fatal )?error: (?P<message>.+)$"
    },
    {
      "tool": "gcc",
      "regex": "^(?P<file>[^\\s:]+):(?P<line>\\d+): (?:fatal )?error: (?P<message>.+)$"
    },
    {
      "tool": "ld",
      "regex": "^(?P<file>[^\\s:]+):(?P<line>\\d+):(?P<col>\\d+): (?P<message>undefined reference to .+)$"
    },
    {
      "tool": "ld",
      "regex": "^(?P<message>(?:/usr/bin/)?ld: .+)$"
    },
    {
      "tool": "make",
      "regex": "^(?P<message>\\S*make(?:\\[\\d+\\])?: \\*\\*\\* .+)$"
    },
    {
      "tool": "cmake",
      "regex": "^CMake Error at (?P<file>[^\\s:]+):(?P<line>\\d+) .*$"
    }
  ],
  "notes": {
    "formatting": "Only when the project has a `.clang-format` file: C-family code has no single standard style."
  },
  "dependabot": [
    {
      "ecosystem": "vcpkg",
      "files": [
        "vcpkg.json"
      ]
    }
  ],
  "renovate": [
    "conan"
  ]
}
