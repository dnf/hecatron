{
  "name": "Groovy",
  "homepage": "https://groovy-lang.org",
  "summary": "Dynamic, Java-compatible language for the JVM.",
  "abbreviation": "gy",
  "dependency": "groovy",
  "lintDependency": null,
  "detect": [],
  "detectSources": [
    "*.groovy"
  ],
  "buildSystems": [
    "Gradle",
    "Maven",
    "groovyc"
  ],
  "testing": "JUnit, Spock",
  "linting": "Gradle check",
  "formatting": "Spotless",
  "docs": "Groovydoc, Javadoc",
  "benchmarks": "JMH",
  "notes": {
    "formatting": "Only when the build applies it; hecatron runs it through the build."
  },
  "cache": {
    "dependencies": [
      "~/.m2/repository",
      "~/.gradle/caches",
      "~/.gradle/wrapper"
    ],
    "lockFiles": [
      "pom.xml",
      "build.gradle",
      "build.gradle.kts",
      "settings.gradle",
      "settings.gradle.kts",
      "gradle.lockfile",
      "gradle/wrapper/gradle-wrapper.properties"
    ]
  },
  "dependabot": [
    {
      "ecosystem": "maven",
      "files": [
        "pom.xml"
      ]
    },
    {
      "ecosystem": "gradle",
      "files": [
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts"
      ]
    }
  ],
  "renovate": [
    "maven",
    "maven-wrapper",
    "gradle",
    "gradle-wrapper"
  ],
  "installNeedsRoot": [
    "linux"
  ]
}
