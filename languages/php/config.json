{
  "name": "PHP",
  "homepage": "https://www.php.net",
  "summary": "The web's server-side workhorse.",
  "abbreviation": null,
  "dependency": "php",
  "lintDependency": null,
  "detect": [
    "composer.json"
  ],
  "path": [
    "{home}/bin"
  ],
  "version": "=8.5.12",
  "track": "stable",
  "pinFiles": [
    {
      "file": ".php-version",
      "format": "php-version"
    },
    {
      "file": "composer.json",
      "format": "composer-json"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "php"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "php"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "php"
    }
  ],
  "supportFiles": [
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "php-version"
    }
  ],
  "asOfPrecision": "line",
  "buildSystems": [
    "Composer"
  ],
  "testing": "PHPUnit",
  "linting": "PHPStan, PHP_CodeSniffer, PHP CS Fixer"
}
