{
  "name": "PHP",
  "homepage": "https://www.php.net",
  "summary": "The web's server-side workhorse.",
  "abbreviation": null,
  "dependency": "php",
  "lintDependency": null,
  "detect": [
    "composer.json"
  ],
  "path": [
    "{home}/bin"
  ],
  "version": "=8.5.12",
  "track": "stable",
  "pinFiles": [
    {
      "file": ".php-version",
      "format": "php-version"
    },
    {
      "file": "composer.json",
      "format": "composer-json"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "php"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "php"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "php"
    }
  ],
  "supportFiles": [
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "php-version"
    }
  ],
  "asOfPrecision": "line",
  "buildSystems": [
    "Composer"
  ],
  "testing": "PHPUnit",
  "linting": "PHPStan, PHP_CodeSniffer, PHP CS Fixer",
  "formatting": "PHP CS Fixer, Laravel Pint",
  "errorPatterns": [
    {
      "tool": "phpunit",
      "regex": "^\\d+\\) (?P<message>\\S+::\\S+)$"
    },
    {
      "tool": "phpunit",
      "regex": "^(?P<message>Failed asserting .+)$"
    },
    {
      "tool": "php",
      "regex": "^(?P<message>\\w+(?:Error|Exception): .+)$"
    },
    {
      "tool": "phpunit",
      "regex": "^(?P<file>/\\S+\\.php):(?P<line>\\d+)$"
    },
    {
      "tool": "php",
      "regex": "^PHP (?:Parse|Fatal) error:\\s+(?P<message>.+) in (?P<file>\\S+) on line (?P<line>\\d+)$"
    }
  ],
  "notes": {
    "formatting": "Only when the project installs one with Composer."
  },
  "cache": {
    "dependencies": [
      "~/.cache/composer"
    ],
    "lockFiles": [
      "composer.lock"
    ]
  },
  "dependabot": "composer",
  "renovate": [
    "composer"
  ],
  "installNeedsRoot": [
    "linux"
  ]
}
