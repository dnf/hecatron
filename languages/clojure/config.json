{
  "name": "Clojure",
  "homepage": "https://clojure.org",
  "summary": "A Lisp on the JVM built around immutable data.",
  "abbreviation": "clj",
  "dependency": "clojure",
  "lintDependency": null,
  "detect": [
    "deps.edn",
    "project.clj"
  ],
  "dirNames": [
    "clojure",
    "clj"
  ],
  "buildSystems": [
    "Clojure CLI (deps.edn)",
    "Leiningen"
  ],
  "testing": "clojure.test",
  "linting": "clj-kondo",
  "formatting": "cljfmt",
  "notes": {
    "formatting": "Only when the project has a `cljfmt.edn`."
  },
  "cache": {
    "dependencies": [
      "~/.m2/repository",
      "~/.gitlibs"
    ],
    "lockFiles": [
      "deps.edn",
      "project.clj"
    ]
  },
  "dependabot": [
    {
      "ecosystem": "maven",
      "files": [
        "pom.xml"
      ]
    }
  ],
  "renovate": [
    "deps-edn",
    "leiningen"
  ],
  "installNeedsRoot": [
    "linux"
  ]
}
