{
  "name": "Python",
  "homepage": "https://www.python.org",
  "summary": "Readable general-purpose language with a vast ecosystem.",
  "abbreviation": "py",
  "dependency": "uv",
  "lintDependency": null,
  "detect": [
    "pyproject.toml",
    "setup.py"
  ],
  "dirNames": [
    "python",
    "py",
    "python3"
  ],
  "path": [
    "{home}/bin",
    "~/.local/bin"
  ],
  "version": "=3.15.1",
  "track": "stable",
  "pinFiles": [
    {
      "file": ".python-version",
      "format": "python-version"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "python"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "python"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "python"
    }
  ],
  "supportFiles": [
    {
      "file": "pyproject.toml",
      "format": "python-classifiers"
    },
    {
      "file": "setup.cfg",
      "format": "python-classifiers"
    },
    {
      "file": "setup.py",
      "format": "python-classifiers"
    },
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "python-version"
    }
  ],
  "oldestInstallable": "3.8",
  "asOfPrecision": "line",
  "env": {
    "UV_PYTHON": "{home}/bin/python3"
  },
  "buildSystems": [
    "uv (pyproject.toml)",
    "setuptools"
  ],
  "testing": "pytest",
  "linting": "Ruff",
  "formatting": "Ruff, or Black where configured",
  "actions": {
    "test": {
      "steps": [
        {
          "run": [
            "uv",
            "run",
            "--all-extras",
            "--with",
            "pytest",
            "pytest"
          ],
          "if": {
            "any": [
              {
                "file": "pyproject.toml"
              },
              {
                "file": "setup.py"
              },
              {
                "file": "setup.cfg"
              }
            ]
          }
        },
        {
          "run": [
            "uv",
            "run",
            "--with",
            "pytest",
            "pytest"
          ],
          "if": {
            "not": {
              "any": [
                {
                  "file": "pyproject.toml"
                },
                {
                  "file": "setup.py"
                },
                {
                  "file": "setup.cfg"
                }
              ]
            }
          }
        }
      ]
    },
    "lint": {
      "steps": [
        {
          "run": [
            "uvx",
            "ruff",
            "check",
            "."
          ]
        }
      ]
    },
    "build": {
      "steps": [
        {
          "if": {
            "not": {
              "any": [
                {
                  "file": "pyproject.toml"
                },
                {
                  "file": "setup.py"
                }
              ]
            }
          },
          "skip": "no pyproject.toml or setup.py to build"
        },
        {
          "run": [
            "uv",
            "build"
          ]
        }
      ]
    },
    "clean": {
      "steps": [
        {
          "remove": [
            "dist",
            "build",
            ".pytest_cache",
            ".ruff_cache",
            "*.egg-info",
            "src/*.egg-info",
            "**/__pycache__"
          ],
          "keep": [
            ".venv"
          ]
        }
      ]
    }
  },
  "install": {
    "via": {
      "tool": "uv",
      "run": [
        "uv",
        "python",
        "install",
        "{version}"
      ]
    },
    "tools": {
      "uv": {
        "version": "0.13.6",
        "archive": {
          "url": "https://github.com/astral-sh/uv/releases/download/{version}/uv-{arch}-{os}.{ext}",
          "checksum": "https://github.com/astral-sh/uv/releases/download/{version}/uv-{arch}-{os}.{ext}.sha256",
          "os": {
            "linux": "unknown-linux-gnu",
            "macos": "apple-darwin",
            "windows": "pc-windows-msvc"
          },
          "arch": {
            "x86_64": "x86_64",
            "aarch64": "aarch64"
          },
          "ext": {
            "windows": "zip",
            "default": "tar.gz"
          },
          "strip": 1
        }
      }
    }
  }
}
