{
  "name": "Python",
  "homepage": "https://www.python.org",
  "summary": "Readable general-purpose language with a vast ecosystem.",
  "abbreviation": "py",
  "dependency": "uv",
  "lintDependency": null,
  "detect": [
    "pyproject.toml",
    "setup.py"
  ],
  "dirNames": [
    "python",
    "py",
    "python3"
  ],
  "path": [
    "{home}/bin",
    "~/.local/bin",
    "~/.local/share/hecatron/python/bin"
  ],
  "version": "=3.15.1",
  "track": "stable",
  "pinFiles": [
    {
      "file": ".python-version",
      "format": "python-version"
    },
    {
      "file": ".tool-versions",
      "format": "tool-versions",
      "key": "python"
    },
    {
      "file": "mise.toml",
      "format": "mise",
      "key": "python"
    },
    {
      "file": ".mise.toml",
      "format": "mise",
      "key": "python"
    }
  ],
  "supportFiles": [
    {
      "file": "pyproject.toml",
      "format": "python-classifiers"
    },
    {
      "file": "setup.cfg",
      "format": "python-classifiers"
    },
    {
      "file": "setup.py",
      "format": "python-classifiers"
    },
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "python-version"
    }
  ],
  "oldestInstallable": "3.8",
  "asOfPrecision": "line",
  "env": {
    "UV_PYTHON": "{home}/bin/python3"
  },
  "buildSystems": [
    "uv (pyproject.toml)",
    "setuptools"
  ],
  "testing": "pytest",
  "linting": "Ruff",
  "formatting": "Ruff, Black",
  "docs": "Sphinx, pdoc",
  "benchmarks": "pytest-benchmark",
  "actions": {
    "test": {
      "find": "below-else-here",
      "files": [
        "pyproject.toml",
        "setup.py",
        "setup.cfg"
      ],
      "steps": [
        {
          "run": [
            "uv",
            "run",
            "--all-extras",
            "--all-groups",
            "--with",
            "pytest",
            "pytest"
          ],
          "if": {
            "any": [
              {
                "file": "pyproject.toml"
              },
              {
                "file": "setup.py"
              },
              {
                "file": "setup.cfg"
              }
            ]
          },
          "args": [
            {
              "if": {
                "all": [
                  {
                    "not": {
                      "any": [
                        {
                          "contains": [
                            "pytest.ini",
                            "python_files"
                          ]
                        },
                        {
                          "contains": [
                            ".pytest.ini",
                            "python_files"
                          ]
                        },
                        {
                          "contains": [
                            "pyproject.toml",
                            "python_files"
                          ]
                        },
                        {
                          "contains": [
                            "setup.cfg",
                            "python_files"
                          ]
                        },
                        {
                          "contains": [
                            "tox.ini",
                            "python_files"
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "glob": "Test*.py"
                  },
                  {
                    "not": {
                      "glob": "test_*.py"
                    }
                  },
                  {
                    "not": {
                      "glob": "*_test.py"
                    }
                  }
                ]
              },
              "add": [
                "-o",
                "python_files=test_*.py *_test.py Test*.py"
              ]
            },
            {
              "if": {
                "not": {
                  "any": [
                    {
                      "contains": [
                        "pytest.ini",
                        "testpaths"
                      ]
                    },
                    {
                      "contains": [
                        ".pytest.ini",
                        "testpaths"
                      ]
                    },
                    {
                      "contains": [
                        "pyproject.toml",
                        "testpaths"
                      ]
                    },
                    {
                      "contains": [
                        "setup.cfg",
                        "testpaths"
                      ]
                    },
                    {
                      "contains": [
                        "tox.ini",
                        "testpaths"
                      ]
                    }
                  ]
                }
              },
              "eachProject": [
                "pyproject.toml",
                "setup.py"
              ],
              "add": [
                "--ignore={dir}"
              ]
            }
          ]
        },
        {
          "run": [
            "uv",
            "run",
            "--with",
            "pytest",
            "pytest"
          ],
          "if": {
            "not": {
              "any": [
                {
                  "file": "pyproject.toml"
                },
                {
                  "file": "setup.py"
                },
                {
                  "file": "setup.cfg"
                }
              ]
            }
          },
          "args": [
            {
              "if": {
                "all": [
                  {
                    "not": {
                      "any": [
                        {
                          "contains": [
                            "pytest.ini",
                            "python_files"
                          ]
                        },
                        {
                          "contains": [
                            ".pytest.ini",
                            "python_files"
                          ]
                        },
                        {
                          "contains": [
                            "pyproject.toml",
                            "python_files"
                          ]
                        },
                        {
                          "contains": [
                            "setup.cfg",
                            "python_files"
                          ]
                        },
                        {
                          "contains": [
                            "tox.ini",
                            "python_files"
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "glob": "Test*.py"
                  },
                  {
                    "not": {
                      "glob": "test_*.py"
                    }
                  },
                  {
                    "not": {
                      "glob": "*_test.py"
                    }
                  }
                ]
              },
              "add": [
                "-o",
                "python_files=test_*.py *_test.py Test*.py"
              ]
            }
          ]
        }
      ]
    },
    "lint": {
      "steps": [
        {
          "run": [
            "uvx",
            "ruff",
            "check",
            "."
          ]
        }
      ]
    },
    "build": {
      "steps": [
        {
          "if": {
            "not": {
              "any": [
                {
                  "file": "pyproject.toml"
                },
                {
                  "file": "setup.py"
                }
              ]
            }
          },
          "skip": "no pyproject.toml or setup.py to build"
        },
        {
          "run": [
            "uv",
            "build"
          ]
        }
      ]
    },
    "clean": {
      "steps": [
        {
          "remove": [
            "dist",
            "build",
            ".pytest_cache",
            ".ruff_cache",
            "*.egg-info",
            "src/*.egg-info",
            "**/__pycache__"
          ],
          "keep": [
            ".venv"
          ]
        }
      ]
    }
  },
  "errorPatterns": [
    {
      "tool": "pytest",
      "regex": "^E\\s+(?P<message>.+)$"
    },
    {
      "tool": "pytest",
      "regex": "^(?P<file>[^\\s:]+\\.py):(?P<line>\\d+): (?P<message>\\w+)$"
    },
    {
      "tool": "pytest",
      "regex": "^(?:FAILED|ERROR) (?P<file>[^\\s:]+\\.py)(?:::\\S+)?(?: - (?P<message>.+))?$"
    },
    {
      "tool": "python",
      "regex": "^\\s*File \\\"(?P<file>[^\\\"]+)\\\", line (?P<line>\\d+)"
    },
    {
      "tool": "python",
      "regex": "^(?P<message>\\w+(?:Error|Exception): .+)$"
    }
  ],
  "notes": {
    "formatting": "Black only where the project configures it; otherwise Ruff."
  },
  "cache": {
    "toolchain": [
      "~/.local/share/uv/python"
    ],
    "dependencies": [
      "~/.cache/uv"
    ],
    "lockFiles": [
      "uv.lock",
      "requirements*.txt",
      "pyproject.toml"
    ]
  },
  "dependabot": [
    {
      "ecosystem": "uv",
      "files": [
        "uv.lock"
      ]
    },
    {
      "ecosystem": "pip",
      "unless": [
        "uv.lock"
      ]
    }
  ],
  "renovate": [
    "pep621",
    "pip_requirements",
    "pip_setup",
    "setup-cfg",
    "pipenv",
    "poetry"
  ],
  "installNeedsRoot": [
    "linux"
  ]
}
