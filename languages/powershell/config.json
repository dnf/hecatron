{
  "name": "PowerShell",
  "homepage": "https://learn.microsoft.com/powershell/",
  "summary": "Cross-platform shell and scripting language built on .NET.",
  "abbreviation": "ps1",
  "dependency": "pwsh",
  "lintDependency": null,
  "detect": [
    "*.psd1"
  ],
  "detectSources": [
    "*.psm1"
  ],
  "dirNames": [
    "powershell",
    "pwsh"
  ],
  "buildSystems": [
    "PowerShell modules"
  ],
  "testing": "Pester",
  "linting": "PSScriptAnalyzer",
  "cache": {
    "toolchain": [
      "~/.local/share/powershell/Modules"
    ]
  },
  "installNeedsRoot": [
    "linux"
  ]
}
