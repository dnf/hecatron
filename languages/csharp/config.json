{
  "name": "C#",
  "homepage": "https://learn.microsoft.com/dotnet/csharp/",
  "summary": "Microsoft's general-purpose language for .NET.",
  "abbreviation": "cs",
  "dependency": "dotnet",
  "lintDependency": null,
  "detect": [
    "*.csproj"
  ],
  "dirNames": [
    "csharp",
    "dotnet",
    "netstd",
    "cs",
    "net"
  ],
  "path": [
    "{home}"
  ],
  "version": "=10.0.403",
  "track": "lts",
  "releaseLine": 3,
  "pinFiles": [
    {
      "file": "global.json",
      "format": "global-json"
    }
  ],
  "supportFiles": [
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "dotnet-version"
    }
  ],
  "oldestInstallable": "6.0",
  "env": {
    "DOTNET_ROOT": "{home}"
  },
  "buildSystems": [
    ".NET SDK (dotnet)"
  ],
  "testing": "dotnet test",
  "linting": "dotnet format",
  "formatting": "dotnet format"
}
