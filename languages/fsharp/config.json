{
  "name": "F#",
  "homepage": "https://fsharp.org",
  "summary": "Functional-first language for .NET.",
  "abbreviation": "fs",
  "dependency": "dotnet",
  "lintDependency": null,
  "detect": [
    "*.fsproj"
  ],
  "dirNames": [
    "fsharp",
    "fs"
  ],
  "path": [
    "{home}"
  ],
  "version": "=10.0.403",
  "track": "lts",
  "releaseLine": 3,
  "pinFiles": [
    {
      "file": "global.json",
      "format": "global-json"
    }
  ],
  "env": {
    "DOTNET_ROOT": "{home}"
  },
  "buildSystems": [
    ".NET SDK (dotnet)"
  ],
  "testing": "dotnet test",
  "linting": "Fantomas"
}
