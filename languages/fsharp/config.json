{
  "name": "F#",
  "homepage": "https://fsharp.org",
  "summary": "Functional-first language for .NET.",
  "abbreviation": "fs",
  "dependency": "dotnet",
  "lintDependency": null,
  "detect": [
    "*.fsproj"
  ],
  "dirNames": [
    "fsharp",
    "fs"
  ],
  "path": [
    "{home}"
  ],
  "version": "=10.0.403",
  "track": "lts",
  "releaseLine": 3,
  "pinFiles": [
    {
      "file": "global.json",
      "format": "global-json"
    }
  ],
  "supportFiles": [
    {
      "file": ".github/workflows/*.y*ml",
      "format": "github-setup",
      "key": "dotnet-version",
      "selects": false
    }
  ],
  "oldestInstallable": "6.0",
  "releasesOf": "csharp",
  "env": {
    "DOTNET_ROOT": "{home}"
  },
  "buildSystems": [
    ".NET SDK (dotnet)"
  ],
  "testing": "dotnet test",
  "linting": "Fantomas",
  "formatting": "Fantomas",
  "notes": {
    "formatting": "Only when Fantomas is in the project's .NET tool manifest."
  },
  "cache": {
    "dependencies": [
      "~/.nuget/packages"
    ],
    "lockFiles": [
      "packages.lock.json",
      "*.fsproj",
      "Directory.Packages.props"
    ]
  },
  "dependabot": "nuget",
  "renovate": [
    "nuget"
  ]
}
