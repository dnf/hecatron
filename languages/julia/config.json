{
  "name": "Julia",
  "homepage": "https://julialang.org",
  "summary": "Fast dynamic language for numerical and scientific computing.",
  "abbreviation": "jl",
  "dependency": "julia",
  "lintDependency": null,
  "detect": [
    "Project.toml"
  ],
  "dirNames": [
    "julia",
    "jl"
  ],
  "buildSystems": [
    "Pkg"
  ],
  "testing": "Test (Pkg.test)",
  "linting": null,
  "formatting": "JuliaFormatter",
  "notes": {
    "formatting": "Only when the project has a `.JuliaFormatter.toml`."
  },
  "cache": {
    "dependencies": [
      "~/.julia"
    ],
    "lockFiles": [
      "Manifest.toml",
      "Project.toml"
    ]
  },
  "dependabot": "julia",
  "installNeedsRoot": [
    "linux"
  ]
}
