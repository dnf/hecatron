{
  "schema": 1,
  "toolchain": {
    "versions": "managed",
    "archive": {
      "url": "https://ziglang.org/download/{version}/zig-{arch}-{os}-{version}.tar.xz",
      "os": {
        "linux": "linux",
        "macos": "macos"
      },
      "arch": {
        "x86_64": "x86_64",
        "aarch64": "aarch64"
      },
      "checksumIndex": {
        "url": "https://ziglang.org/download/index.json",
        "path": [
          "{version}",
          "{arch}-{os}",
          "shasum"
        ],
        "urlPath": [
          "{version}",
          "{arch}-{os}",
          "tarball"
        ]
      },
      "strip": 1,
      "check": {
        "run": [
          "{bin}/zig",
          "version"
        ]
      }
    }
  },
  "links": [
    "zig"
  ]
}
