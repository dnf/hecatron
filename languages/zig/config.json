{
  "name": "Zig",
  "homepage": "https://ziglang.org",
  "summary": "Simple systems language and C toolchain, with comptime.",
  "abbreviation": "zg",
  "dependency": "zig",
  "lintDependency": null,
  "detect": [
    "build.zig"
  ],
  "buildSystems": [
    "zig build"
  ],
  "testing": "zig build test",
  "linting": "zig fmt",
  "formatting": "zig fmt",
  "docs": "zig build docs",
  "benchmarks": "zig build bench",
  "cache": {
    "dependencies": [
      "~/.cache/zig"
    ],
    "lockFiles": [
      "build.zig.zon"
    ]
  },
  "version": "=0.17.0",
  "track": "stable",
  "pinFiles": [
    {
      "file": "build.zig.zon",
      "format": "build-zig-zon"
    }
  ],
  "path": [
    "{home}"
  ],
  "installNeedsRoot": [
    "linux"
  ]
}
