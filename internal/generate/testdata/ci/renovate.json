{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "DO NOT EDIT: generated by hecatron workflows (generated.renovate) from the project's languages and components.",
    "To update: edit .hecatron/config.json's \"renovate\", then run hecatron workflows (hecatron add and remove do too)."
  ],
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "enabledManagers": [
    "nuget",
    "gomod",
    "haskell-cabal",
    "maven",
    "maven-wrapper",
    "gradle",
    "gradle-wrapper",
    "sbt",
    "npm",
    "bun",
    "pep621",
    "pip_requirements",
    "pip_setup",
    "setup-cfg",
    "pipenv",
    "poetry",
    "cargo",
    "github-actions"
  ],
  "includePaths": [
    "age/csharp/**",
    "age/go/**",
    "age/haskell/**",
    "age/java/**",
    "date/java/**",
    "age/javascript/**",
    "date/javascript/**",
    "age/python/**",
    "date/python/**",
    "age/rust/**",
    "date/rust/**",
    ".github/workflows/**"
  ]
}
