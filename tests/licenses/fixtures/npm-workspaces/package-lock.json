{
  "name": "ws-root",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ws-root",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@ws/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@ws/util": {
      "resolved": "packages/util",
      "link": true
    },
    "node_modules/is-number": {
      "version": "7.0.0",
      "resolved": "https://registry.npmjs.org/is-number/-/is-number-7.0.0.tgz"
    },
    "node_modules/left-pad": {
      "version": "1.3.0",
      "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz"
    },
    "packages/app": {
      "name": "@ws/app",
      "version": "0.1.0",
      "dependencies": {
        "@ws/util": "*",
        "left-pad": "1.3.0"
      }
    },
    "packages/util": {
      "name": "@ws/util",
      "version": "0.2.0",
      "dependencies": {
        "is-number": "7.0.0"
      }
    }
  }
}
