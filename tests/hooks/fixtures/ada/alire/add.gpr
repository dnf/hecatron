with "config/add_config.gpr";

library project Add is
   for Library_Name use "add";
   for Library_Version use Project'Library_Name & ".so." & Add_Config.Crate_Version;
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Add_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";
end Add;
