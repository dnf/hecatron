{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dnf/hecatron/main/tests/real-projects/schema.json",
  "title": "Hecatron real-project tests",
  "description": "The data files of tests/real-projects: projects.json (the backlog, with each repository's GitHub metadata), results.json (one run record per project tested) and results-by-language.json (one row per project and language). Each file has a schemaVersion; a change that removes or renames a field, or changes its meaning, increases it.",
  "oneOf": [
    {"$ref": "#/$defs/projectsFile"},
    {"$ref": "#/$defs/resultsFile"},
    {"$ref": "#/$defs/byLanguageFile"}
  ],
  "$defs": {
    "schemaVersion": {"type": "integer", "enum": [1]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "category": {
      "description": "polyglot: one project in several languages; single: a well-known project in one or two languages; stress: monorepos, several build systems, native extensions.",
      "enum": ["polyglot", "single", "stress"]
    },
    "language": {"type": "string", "pattern": "^[a-z]+$"},
    "seconds": {"type": "number", "minimum": 0},
    "step": {
      "description": "One timed command: its exit code (124 when the harness stopped it at its time limit) and wall seconds.",
      "type": "object",
      "required": ["rc", "seconds"],
      "properties": {
        "rc": {"type": "integer"},
        "seconds": {"$ref": "#/$defs/seconds"}
      },
      "additionalProperties": false
    },

    "projectsFile": {
      "type": "object",
      "required": ["schemaVersion", "verified", "criteria", "projects", "dropped"],
      "properties": {
        "schemaVersion": {"$ref": "#/$defs/schemaVersion"},
        "verified": {"$ref": "#/$defs/date", "description": "When every entry was last checked against the GitHub API (tests/real-projects/verify.py)."},
        "criteria": {"type": "string"},
        "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}},
        "dropped": {
          "description": "Repositories considered and left out, and why.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repo", "reason", "date"],
            "properties": {
              "repo": {"$ref": "#/$defs/repo"},
              "reason": {"type": "string"},
              "replacement": {"$ref": "#/$defs/repo"},
              "date": {"$ref": "#/$defs/date"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["repo", "category", "languages", "why", "github"],
      "properties": {
        "repo": {"$ref": "#/$defs/repo"},
        "category": {"$ref": "#/$defs/category"},
        "languages": {"description": "The hecatron languages expected to be detected.", "type": "array", "items": {"$ref": "#/$defs/language"}},
        "why": {"type": "string"},
        "github": {"$ref": "#/$defs/github"}
      },
      "additionalProperties": false
    },
    "github": {
      "description": "The repository's metadata from the GitHub API (repos/O/R and repos/O/R/languages), as of fetched.",
      "type": "object",
      "required": ["fetched", "description", "topics", "license", "stars", "forks", "sizeKB", "defaultBranch", "pushedAt", "archived", "primaryLanguage", "languageBytes", "homepage"],
      "properties": {
        "fetched": {"$ref": "#/$defs/date"},
        "description": {"type": ["string", "null"]},
        "topics": {"type": "array", "items": {"type": "string"}},
        "license": {"description": "SPDX identifier, NOASSERTION, or null.", "type": ["string", "null"]},
        "stars": {"type": "integer", "minimum": 0},
        "forks": {"type": "integer", "minimum": 0},
        "sizeKB": {"type": "integer", "minimum": 0},
        "defaultBranch": {"type": "string"},
        "pushedAt": {"type": "string"},
        "archived": {"type": "boolean"},
        "primaryLanguage": {"description": "GitHub's (linguist's) name, not hecatron's.", "type": ["string", "null"]},
        "languageBytes": {"type": "object", "additionalProperties": {"type": "integer"}},
        "homepage": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },

    "resultsFile": {
      "type": "object",
      "required": ["schemaVersion", "results"],
      "properties": {
        "schemaVersion": {"$ref": "#/$defs/schemaVersion"},
        "results": {"type": "array", "items": {"$ref": "#/$defs/run"}}
      },
      "additionalProperties": false
    },
    "run": {
      "description": "One project's newest run of tests/real-projects/run.sh.",
      "type": "object",
      "required": ["repo", "date", "commit", "hecatron", "runner", "wallSeconds", "complete", "clone", "init", "install", "doctor", "status", "languages"],
      "properties": {
        "actions": {"description": "The actions run for each language (run.sh --actions), in order: test, and lint or build when asked for.", "type": "array", "items": {"enum": ["test", "lint", "build"]}},
        "repo": {"$ref": "#/$defs/repo"},
        "date": {"$ref": "#/$defs/date"},
        "commit": {"description": "The project's commit tested (its default branch's head at the time).", "type": ["string", "null"]},
        "hecatron": {
          "type": "object",
          "required": ["version", "commit", "runner"],
          "properties": {
            "version": {"type": "string"},
            "commit": {"type": ["string", "null"]},
            "runner": {"description": "binary: the Go core (docs/contributing/design.md section 19); scripts: bin/hecatron's scripts.", "enum": ["binary", "scripts"]}
          },
          "additionalProperties": false
        },
        "runner": {
          "type": "object",
          "required": ["os", "arch", "image", "host", "runUrl"],
          "properties": {
            "os": {"type": "string"},
            "arch": {"type": "string"},
            "image": {"type": ["string", "null"], "description": "The base image of the container, when run in one."},
            "host": {"type": ["string", "null"], "description": "Where the container ran, such as a GitHub-hosted runner."},
            "runUrl": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "wallSeconds": {"$ref": "#/$defs/seconds"},
        "complete": {"description": "False when the log ended before the harness finished (the job's time limit, or a crash).", "type": "boolean"},
        "cache": {
          "description": "The toolchain caches (tests/real-projects/cache.py): whether the job used them, and the languages whose installs it restored before hct install. Null when the job ran without cache.py.",
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["enabled", "restored"],
              "properties": {
                "enabled": {"type": "boolean"},
                "restored": {"type": "array", "items": {"$ref": "#/$defs/language"}}
              },
              "additionalProperties": false
            }
          ]
        },
        "clone": {"anyOf": [{"$ref": "#/$defs/step"}, {"type": "null"}]},
        "init": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["rc", "seconds", "languages", "components", "notAdded"],
              "properties": {
                "rc": {"type": "integer"},
                "seconds": {"$ref": "#/$defs/seconds"},
                "languages": {"type": "array", "items": {"$ref": "#/$defs/language"}},
                "components": {
                  "description": "Each component and, per language, the directory hecatron resolved for it (from hct status).",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "dirs"],
                    "properties": {
                      "name": {"type": "string"},
                      "dirs": {"type": "object", "additionalProperties": {"type": "string"}}
                    },
                    "additionalProperties": false
                  }
                },
                "notAdded": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["language", "reason"],
                    "properties": {"language": {"type": "string"}, "reason": {"type": "string"}},
                    "additionalProperties": false
                  }
                },
                "config": {"description": "The .hecatron/config.json init wrote.", "type": ["object", "null"]}
              },
              "additionalProperties": false
            }
          ]
        },
        "install": {"anyOf": [{"$ref": "#/$defs/step"}, {"type": "null"}]},
        "doctor": {"anyOf": [{"$ref": "#/$defs/step"}, {"type": "null"}]},
        "status": {"description": "hct status --output json after init, as printed.", "type": ["object", "null"]},
        "disk": {
          "description": "Free space on the disk holding the workspace (df), sampled at the start, after each step and at the end; null in runs from before it was recorded.",
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["sizeKB", "freeBeforeKB", "freeAfterKB", "minFreeKB", "minFreeAfter", "low"],
              "properties": {
                "sizeKB": {"type": ["integer", "null"], "minimum": 0},
                "freeBeforeKB": {"type": "integer", "minimum": 0},
                "freeAfterKB": {"type": "integer", "minimum": 0},
                "minFreeKB": {"type": "integer", "minimum": 0},
                "minFreeAfter": {"description": "The sample with the least free space: start, a step's name (install, test:go...) or end.", "type": "string"},
                "low": {"description": "Whether the free space fell under 2 GB: close to running out.", "type": "boolean"}
              },
              "additionalProperties": false
            }
          ]
        },
        "languages": {"type": "array", "items": {"$ref": "#/$defs/languageResult"}}
      },
      "additionalProperties": false
    },
    "languageResult": {
      "type": "object",
      "required": ["language", "result", "toolchain", "buildSystems", "components", "steps"],
      "properties": {
        "language": {"$ref": "#/$defs/language"},
        "result": {"$ref": "#/$defs/result"},
        "toolchain": {
          "description": "From hct status: the versions the language resolved to, each with where it came from, and whether the toolchain was found.",
          "type": "object",
          "required": ["versions", "state"],
          "properties": {
            "versions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["spec", "sources"],
                "properties": {
                  "spec": {"type": "string"},
                  "exact": {"type": "boolean"},
                  "sources": {"type": "array", "items": {"type": "string"}}
                },
                "additionalProperties": true
              }
            },
            "state": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "install": {
          "description": "What hct install said it couldn't do for the language: install its toolchain, or fetch its dependencies. Absent in runs recorded before it was.",
          "type": "object",
          "required": ["toolchainFailed", "depsFailed"],
          "properties": {"toolchainFailed": {"type": "boolean"}, "depsFailed": {"type": "boolean"}},
          "additionalProperties": false
        },
        "buildSystems": {"description": "The tools the language's hooks ran (from the log's '+ <command>' lines).", "type": "array", "items": {"type": "string"}},
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "dir", "failed"],
            "properties": {"name": {"type": "string"}, "dir": {"type": "string"}, "failed": {"type": "boolean"}},
            "additionalProperties": false
          }
        },
        "steps": {
          "description": "Each action run for the language (test; lint and build when the run asked for them).",
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/actionResult"}
        }
      },
      "additionalProperties": false
    },
    "result": {
      "description": "pass: the test step (every step, when the run didn't test) exited 0. fail: it didn't. not-run: the run ended (time limit) before it.",
      "enum": ["pass", "fail", "not-run"]
    },
    "failureCategory": {
      "description": "Why a step failed, from its exit code, its counts and its output (report.py's FAILURE_PATTERNS). toolchain: not installed or not found; toolchain-version: too new or too old for the project; system: a system tool or library missing; network; disk: out of space; dependencies: fetching or resolving them failed; setup: the project needs a step of its own first (generated code, a service, a native library); build: a compile error; no-tests: none found; tests: tests failed; lint: the linter reported problems; no-command: no command for the layout; timeout.",
      "enum": ["toolchain", "toolchain-version", "system", "network", "disk", "dependencies", "setup", "build", "no-tests", "tests", "lint", "no-command", "timeout", "other"]
    },
    "actionResult": {
      "type": "object",
      "required": ["rc", "seconds", "counts", "failure"],
      "properties": {
        "rc": {"type": "integer"},
        "seconds": {"$ref": "#/$defs/seconds"},
        "counts": {
          "description": "The test runner's own summary, where the harness could parse it; tool junit-xml: totalled from the JUnit XML reports the step wrote (Gradle's, which prints no counts when tests pass).",
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["tool"],
              "properties": {
                "tool": {"type": "string"},
                "passed": {"type": "integer", "minimum": 0},
                "failed": {"type": "integer", "minimum": 0},
                "skipped": {"type": "integer", "minimum": 0},
                "total": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          ]
        },
        "failure": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["category", "excerpt"],
              "properties": {
                "category": {"$ref": "#/$defs/failureCategory"},
                "excerpt": {"description": "The error lines hecatron's agent output picked, else the log's last lines.", "type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },

    "byLanguageFile": {
      "type": "object",
      "required": ["schemaVersion", "rows"],
      "properties": {
        "schemaVersion": {"$ref": "#/$defs/schemaVersion"},
        "rows": {
          "description": "One row per backlog project and language (expected or detected), flat for filtering.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repo", "category", "language", "expected", "detected", "result", "seconds", "failureCategory", "commit", "date", "hecatronVersion"],
            "properties": {
              "repo": {"$ref": "#/$defs/repo"},
              "category": {"$ref": "#/$defs/category"},
              "language": {"$ref": "#/$defs/language"},
              "expected": {"type": "boolean"},
              "detected": {"type": ["boolean", "null"], "description": "Whether hct init added it; null before the project is tested."},
              "result": {"enum": ["pass", "fail", "not-run", "not-detected", "untested"]},
              "seconds": {"type": ["number", "null"]},
              "failureCategory": {"anyOf": [{"$ref": "#/$defs/failureCategory"}, {"type": "null"}]},
              "commit": {"type": ["string", "null"]},
              "date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
              "hecatronVersion": {"type": ["string", "null"]},
              "actions": {"description": "The other actions' results (lint, build), when the run asked for them.", "type": "object", "additionalProperties": {"enum": ["pass", "fail"]}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
